// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  citizen
}

model ServiceType {
  id     String @id @default(cuid())
  slug   String @unique // e.g. "hospital", "government_office"
  name   String         // English display name
  nameNp String         // Nepali display name
  icon   String @default("🏢")
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  password      String?
  role          Role        @default(citizen)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  reports       Report[]
  badges        UserBadge[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Province {
  id        String     @id @default(cuid())
  name      String     @unique
  nameNp    String
  districts District[]
}

model District {
  id             String         @id @default(cuid())
  name           String
  nameNp         String
  provinceId     String
  province       Province       @relation(fields: [provinceId], references: [id])
  constituencies Constituency[]

  @@unique([name, provinceId])
}

model Constituency {
  id          String          @id @default(cuid())
  name        String
  nameNp      String
  imageUrl    String?
  description String?
  province    String?
  districtId  String?
  district    District?       @relation(fields: [districtId], references: [id])
  services    PublicService[]
  reports     Report[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PublicService {
  id             String       @id @default(cuid())
  name           String
  nameNp         String
  type           String       @default("other")
  location       String?
  description    String?
  descriptionNp  String?
  imageUrl       String?
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  reports        Report[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Report {
  id                 String        @id @default(cuid())
  publicServiceId    String
  constituencyId     String
  userId             String?
  serviceTimeMinutes Int
  rating             Int
  comment            String?
  mediaUrl           String?
  isModerated        Boolean       @default(false)
  isHidden           Boolean       @default(false)
  publicService      PublicService @relation(fields: [publicServiceId], references: [id], onDelete: Cascade)
  constituency       Constituency  @relation(fields: [constituencyId], references: [id])
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  // One active report per authenticated user per service (nulls are not considered equal, so anonymous reports are unrestricted)
  @@unique([userId, publicServiceId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  nameNp      String
  description String
  icon        String
  condition    String
  conditionNp  String      @default("")
  userBadges   UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}
